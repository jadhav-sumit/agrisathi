# =============================================================================
# AgriSathi (Kisan Saathi) - Public Frontend Environment Configuration
# =============================================================================
# NOTICE:
# Variables with the 'VITE_' prefix are statically baked into the browser bundle.
# NEVER put private API secrets, secret keys, or database credentials here.

# Optional API base URL override (Defaults to relative /api when left empty)
VITE_API_BASE_URL=

# Optional custom OpenWeather override (Open-Meteo is active by default without keys)
# VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
# VITE_WEATHER_API_KEY=
