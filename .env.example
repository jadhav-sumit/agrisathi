# =============================================================================
# AgriSathi (Kisan Saathi) - Server Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# Copy this file to .env and replace the placeholder values with your real credentials:
#   copy .env.example .env
#
# IMPORTANT SECURITY RULES:
# - Never commit real keys to Git or expose them in client frontend bundles.
# - The .env file is gitignored by default.

# -----------------------------------------------------------------------------
# 1. Server & Security Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_random_key_here

# -----------------------------------------------------------------------------
# 2. MySQL Database Configuration (Optional - falls back to local storage if empty)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agrisathi

# -----------------------------------------------------------------------------
# 3. OpenWeather API (Weather forecasts & rainfall alerts)
# -----------------------------------------------------------------------------
# Portal: https://openweathermap.org/
# Free tier: 60 calls/min, 1,000,000 calls/month
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -----------------------------------------------------------------------------
# 4. Geoapify API (Geocoding, Maps & Location Services)
# -----------------------------------------------------------------------------
# Portal: https://www.geoapify.com/
# Free tier: 3,000 requests/day
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# -----------------------------------------------------------------------------
# 5. NASA API (NASA Earth & Agroclimatology)
# -----------------------------------------------------------------------------
# Portal: https://api.nasa.gov/ and https://power.larc.nasa.gov/
NASA_API_KEY=your_nasa_api_key_here

# -----------------------------------------------------------------------------
# 6. Groq AI API (Ultra-Fast Llama 3.3 70B Agricultural Advisory)
# -----------------------------------------------------------------------------
# Portal: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# 7. Mistral AI API (Multilingual Agricultural Guidance)
# -----------------------------------------------------------------------------
# Portal: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# -----------------------------------------------------------------------------
# 8. Google Gemini API (Alternative LLM Fallback)
# -----------------------------------------------------------------------------
# Portal: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 9. Plant.id API (Leaf & Crop Disease Vision Analysis)
# -----------------------------------------------------------------------------
# Portal: https://plant.id/
PLANT_ID_API_KEY=your_plant_id_api_key_here

# -----------------------------------------------------------------------------
# 10. Data.gov.in Agmarknet API (Real-time Mandi Commodity Prices)
# -----------------------------------------------------------------------------
# Portal: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
