# =============================================================================
# AgriSathi (Kisan Saathi) - Server Environment Configuration
# =============================================================================
# IMPORTANT SECURITY NOTICE:
# - Server-side secrets MUST NEVER be exposed to the browser or prefixed with VITE_.
# - NEVER commit real credentials or .env files into version control (Git).
# - Copy this file to .env and populate your personal API keys as needed.

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. Google Gemini API Key (Required for AI Agricultural Assistant)
# -----------------------------------------------------------------------------
# Provider: Google AI Studio
# Portal: https://aistudio.google.com/
# Free Tier: 15 RPM, 1,500 RPD on gemini-2.5-flash / gemini-1.5-flash (free tier)
# Consumed in: server/routes.ts -> POST /api/chat
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 3. Plant.id API Key (Required for Live Leaf & Crop Disease Vision Analysis)
# -----------------------------------------------------------------------------
# Provider: Kindwise (Plant.id)
# Portal: https://plant.id/ or https://web.plant.id/
# Free Tier: Free evaluation credits upon registration
# Note: When empty, the app runs gracefully using verified symptom guidance.
# Consumed in: server/routes.ts -> POST /api/identify-disease
PLANT_ID_API_KEY=

# -----------------------------------------------------------------------------
# 4. Government Open Data API Key (Optional for Live Mandi Daily Sync)
# -----------------------------------------------------------------------------
# Provider: Government of India (Data.gov.in)
# Portal: https://data.gov.in/
# Resource: Agmarknet Daily Market Prices
# Note: When empty, the app displays verified Maharashtra APMC benchmark rates.
# Consumed in: server/routes.ts -> GET /api/mandi-prices
DATA_GOV_IN_API_KEY=

# -----------------------------------------------------------------------------
# 5. Free Services Operating Without Keys (Built-in)
# -----------------------------------------------------------------------------
# - Open-Meteo Weather API: https://open-meteo.com/ (No API key required)
# - OpenStreetMap + Leaflet Maps: https://www.openstreetmap.org/ (No key required)
# - Nominatim Geocoding API: https://nominatim.org/ (No key required)
